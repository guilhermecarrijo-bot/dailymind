# NODE_ENV: Ambiente da aplicação. Valores: development | test | production
NODE_ENV=development

# Porta do servidor Express
PORT=3000

# FRONTEND_ORIGIN: Origem do frontend para CORS com credenciais (cookies).
# Nunca use '*' quando há cookies com credenciais.
# Valor aceito: URI origin (ex: http://localhost:5500, https://dailymind.fr)
FRONTEND_ORIGIN=http://localhost:5500

# CHAVE_SESSAO: Chave HMAC para assinatura de tokens de sessão.
# Deve ter pelo menos 32 bytes (64 caracteres hexadecimais).
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CHAVE_SESSAO=

# COOKIE_SECURE: Se verdadeiro, o cookie de sessão só será enviado via HTTPS.
# Em desenvolvimento use false; em produção com HTTPS, use true.
COOKIE_SECURE=false